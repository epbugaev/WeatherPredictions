# Comet ML credentials.
# Picked up by `comet_ml.login()` in utils/experiment.py when `logging.comet_api_key`
# is empty in the YAML config. Required for non-offline runs on the main DDP rank.
COMET_API_KEY=

# Optional Comet overrides. If unset, Comet falls back to the workspace tied to the
# API key and the project name passed from `logging.comet_project` in the YAML.
COMET_WORKSPACE=
COMET_PROJECT_NAME=
