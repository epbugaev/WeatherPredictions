# Copy this file to `.env` on each machine/cluster account before running jobs.
# `sh_files/_shell_contract.sh` sources it automatically.

# Comet ML credentials. Required for non-offline runs on the main DDP rank.
COMET_API_KEY=

# Comet workspace/project used by helper scripts and optional Comet overrides.
# Use the workspace slug from your Comet URL; do not hardcode it in committed code.
COMET_WORKSPACE=
COMET_PROJECT_NAME=weatherpredictions

# Cluster/runtime paths. Set these per user.
REPO_ROOT=/home/your_cluster_user/WeatherPredictions
REMOTE_USER=your_cluster_user
REMOTE_REPO=/home/your_cluster_user/WeatherPredictions
WEATHERPRED_CONDA_ENV_NAME=weatherpred-gft-fix
# Prefer this if you have multiple envs, e.g. weatherpred-refactor:
# CONDA_ENV_BIN=/home/your_cluster_user/.conda/envs/weatherpred-refactor/bin

# Output/storage paths. `CHECKPOINT_BASE_OVERRIDE` takes precedence if set.
WEATHERPRED_CHECKPOINT_BASE=/home/your_cluster_user/checkpoints
WEATHERPRED_MEMMAP_DIR=/home/your_cluster_user/era5_memmap
WEATHERPRED_USA_MEMMAP=/home/your_cluster_user/era5_memmap/predformer_usa_2000_2004.dat
WEATHERPRED_GLOBE_MEMMAP=/home/your_cluster_user/era5_memmap/predformer_globe_2000_2018.dat

# WeatherBench input paths. The default root is the shared HSE path below;
# override only if your account uses a different data location.
WEATHERBENCH_ROOT=/home/fratnikov/weather_bench
# Optional fine-grained overrides:
# WEATHERBENCH_INPUT_ROOT=/home/fratnikov/weather_bench/1.40625deg
# WEATHERBENCH_NPY_ROOT=/home/fratnikov/weather_bench/npy/1.40625deg
# WEATHERBENCH_MEAN_STD_PATH=/home/fratnikov/weather_bench/1.40625deg/mean_std.npy
# WEATHERBENCH_CONSTANTS_PATH=/home/fratnikov/weather_bench/1.40625deg/constants/constants_1.40625deg.nc
